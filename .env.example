# SHIN: The Struggle — NEAR Protocol Edition
# Copy to `client/.env.local` or `server/.env` if customizing endpoints.
# The Next.js client runs out-of-the-box with zero configuration required.

NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_NEAR_RPC_URL=https://rpc.testnet.near.org
NEXT_PUBLIC_NEAR_CONTRACT_ID=shin-arena.testnet
NEXT_PUBLIC_SERVER_URL=http://localhost:3005
