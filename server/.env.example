# SHIN: NEAR Protocol Arena Server (.env.example)
PORT=3005
NEAR_NETWORK=testnet
NEAR_RPC_URL=https://rpc.testnet.near.org
NEAR_CONTRACT_ID=shin-arena.testnet
NEAR_REFEREE_ACCOUNT_ID=referee.shin-arena.testnet
NEAR_USDC_CONTRACT=usdc.fakes.testnet
NEAR_USDT_CONTRACT=usdt.fakes.testnet

# Optional MongoDB & Auth settings (Client works standalone with Instant Warrior Login)
MONGO_URI=mongodb://localhost:27017/shin-near
JWT_SECRET=replace_with_jwt_secret
ENCRYPTION_KEY=replace_with_32_byte_encryption_key
